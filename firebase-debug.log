[debug] [2026-08-24T05:19:03.967Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/mangaworld-live-260519/rulesets {"name":"projects/mangaworld-live-260519/rulesets/674dd5bc-9e33-4b48-9b19-99fccb9eda17","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function owner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function canWriteCommunity(authorUid) {\n      return signedIn()\n        && request.auth.token.firebase.sign_in_provider != 'anonymous'\n        && request.auth.uid == authorUid;\n    }\n\n    function canModerate() {\n      return signedIn() && request.auth.token.role in ['moderator', 'super-admin'];\n    }\n\n    function hasInitialContentCounters() {\n      return (!request.resource.data.keys().hasAny(['likes']) || request.resource.data.likes == 0)\n        && (!request.resource.data.keys().hasAny(['dislikes']) || request.resource.data.dislikes == 0)\n        && request.resource.data.replyCount == 0\n        && request.resource.data.reportedCount == 0;\n    }\n\n    function authorOnlyCommentEdit() {\n      return canWriteCommunity(resource.data.authorUid)\n        && request.resource.data.authorUid == resource.data.authorUid\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['text', 'spoiler', 'mentions', 'isDeleted', 'editedAt', 'authorName', 'authorUsername', 'authorAvatarUrl'])\n        && request.resource.data.text is string\n        && request.resource.data.spoiler is bool\n        && request.resource.data.mentions is list\n        && request.resource.data.mentions.size() <= 10\n        && authorSnapshotMatchesPublicProfile()\n        // Soft-deleted content remains as an immutable thread anchor.\n        && (!resource.data.keys().hasAny(['isDeleted']) || resource.data.isDeleted == false)\n        && (\n          !request.resource.data.keys().hasAny(['isDeleted'])\n          || request.resource.data.isDeleted == false\n          || (\n            request.resource.data.isDeleted == true\n            && request.resource.data.text == ''\n            && request.resource.data.mentions.size() == 0\n          )\n        );\n    }\n\n    function authorOnlyReviewEdit() {\n      return canWriteCommunity(resource.data.authorUid)\n        && request.resource.data.authorUid == resource.data.authorUid\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.title is string\n        && request.resource.data.body is string\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['rating', 'title', 'body', 'isDeleted', 'updatedAt', 'authorName', 'authorUsername', 'authorAvatarUrl'])\n        && authorSnapshotMatchesPublicProfile()\n        // Soft-deleted reviews also remain immutable so their replies retain a stable root.\n        && (!resource.data.keys().hasAny(['isDeleted']) || resource.data.isDeleted == false)\n        && (\n          !request.resource.data.keys().hasAny(['isDeleted'])\n          || request.resource.data.isDeleted == false\n          || (\n            request.resource.data.isDeleted == true\n            && request.resource.data.title == ''\n            && request.resource.data.body == ''\n          )\n        );\n    }\n\n    // A profile update may refresh the denormalized author snapshot on the user's existing\n    // comments and reviews. Only accept it when the new snapshot equals that public profile.\n    function authorSnapshotMatchesPublicProfile() {\n      return !request.resource.data.diff(resource.data).affectedKeys()\n          .hasAny(['authorName', 'authorUsername', 'authorAvatarUrl'])\n        || (\n          exists(/databases/$(database)/documents/publicProfiles/$(resource.data.authorUid))\n          && request.resource.data.authorName\n            == get(/databases/$(database)/documents/publicProfiles/$(resource.data.authorUid)).data.displayName\n          && request.resource.data.authorUsername\n            == get(/databases/$(database)/documents/publicProfiles/$(resource.data.authorUid)).data.username\n          && request.resource.data.authorAvatarUrl\n            == get(/databases/$(database)/documents/publicProfiles/$(resource.data.authorUid)).data.avatarUrl\n        );\n    }\n\n    function isMangaCommentRoot(mangaId, rootId) {\n      return rootId is string\n        && exists(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId))\n        && get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.id == rootId\n        && (!get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.keys().hasAny(['parentId'])\n          || get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.parentId == null)\n        && (!get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.keys().hasAny(['reviewId'])\n          || get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.reviewId == null);\n    }\n\n    function matchesMangaRootRecipient(mangaId, rootId) {\n      return request.resource.data.replyToUid == null\n          || request.resource.data.replyToUid == get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.authorUid;\n    }\n\n    function matchesMangaRootUsername(mangaId, rootId) {\n      return request.resource.data.replyToUsername == null\n          || request.resource.data.replyToUsername == get(/databases/$(database)/documents/community_manga/$(mangaId)/comments/$(rootId)).data.authorUsername;\n    }\n\n    function isMangaReviewRoot(mangaId, reviewId) {\n      return reviewId is string\n        && exists(/databases/$(database)/documents/community_manga/$(mangaId)/reviews/$(reviewId))\n        && get(/databases/$(database)/documents/community_manga/$(mangaId)/reviews/$(reviewId)).data.id == reviewId;\n    }\n\n    function matchesMangaReviewRecipient(mangaId, reviewId) {\n      return request.resource.data.replyToUid == null\n          || request.resource.data.replyToUid == get(/databases/$(database)/documents/community_manga/$(mangaId)/reviews/$(reviewId)).data.authorUid;\n    }\n\n    function matchesMangaReviewUsername(mangaId, reviewId) {\n      return request.resource.data.replyToUsername == null\n          || request.resource.data.replyToUsername == get(/databases/$(database)/documents/community_manga/$(mangaId)/reviews/$(reviewId)).data.authorUsername;\n    }\n\n    function isChapterCommentRoot(mangaId, chapterKey, rootId) {\n      return rootId is string\n        && exists(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId))\n        && get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.id == rootId\n        && (!get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.keys().hasAny(['parentId'])\n          || get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.parentId == null)\n        && (!get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.keys().hasAny(['reviewId'])\n          || get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.reviewId == null);\n    }\n\n    function matchesChapterRootRecipient(mangaId, chapterKey, rootId) {\n      return request.resource.data.replyToUid == null\n          || request.resource.data.replyToUid == get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.authorUid;\n    }\n\n    function matchesChapterRootUsername(mangaId, chapterKey, rootId) {\n      return request.resource.data.replyToUsername == null\n          || request.resource.data.replyToUsername == get(/databases/$(database)/documents/community_manga/$(mangaId)/chapters/$(chapterKey)/comments/$(rootId)).data.authorUsername;\n    }\n\n    function validCommentBase(mangaId, commentId) {\n      return canWriteCommunity(request.resource.data.authorUid)\n        && request.resource.data.id == commentId\n        && request.resource.data.mangaId == mangaId\n        && request.resource.data.text is string\n        && request.resource.data.mentions is list\n        && request.resource.data.mentions.size() <= 10\n        && request.resource.data.spoiler is bool\n        && request.resource.data.isDeleted == false\n        && hasInitialContentCounters();\n    }\n\n    function validMangaCommentStructure(mangaId) {\n      return (\n          request.resource.data.parentId == null\n          && request.resource.data.threadRootId == null\n          && request.resource.data.reviewId == null\n          && request.resource.data.replyToUid == null\n          && request.resource.data.replyToUsername == null\n        ) || (\n          request.resource.data.parentId is string\n          && request.resource.data.threadRootId == request.resource.data.parentId\n          && request.resource.data.reviewId == null\n          && isMangaCommentRoot(mangaId, request.resource.data.parentId)\n          && matchesMangaRootRecipient(mangaId, request.resource.data.parentId)\n          && matchesMangaRootUsername(mangaId, request.resource.data.parentId)\n        ) || (\n          request.resource.data.parentId == null\n          && request.resource.data.threadRootId == null\n          && isMangaReviewRoot(mangaId, request.resource.data.reviewId)\n          && matchesMangaReviewRecipient(mangaId, request.resource.data.reviewId)\n          && matchesMangaReviewUsername(mangaId, request.resource.data.reviewId)\n        );\n    }\n\n    function validChapterCommentStructure(mangaId, chapterKey) {\n      return (\n          request.resource.data.parentId == null\n          && request.resource.data.threadRootId == null\n          && request.resource.data.reviewId == null\n          && request.resource.data.replyToUid == null\n          && request.resource.data.replyToUsername == null\n        ) || (\n          request.resource.data.parentId is string\n          && request.resource.data.threadRootId == request.resource.data.parentId\n          && request.resource.data.reviewId == null\n          && isChapterCommentRoot(mangaId, chapterKey, request.resource.data.parentId)\n          && matchesChapterRootRecipient(mangaId, chapterKey, request.resource.data.parentId)\n          && matchesChapterRootUsername(mangaId, chapterKey, request.resource.data.parentId)\n        );\n    }\n\n    function validReviewCreate(mangaId, reviewId) {\n      return canWriteCommunity(request.resource.data.authorUid)\n        && request.auth.uid == reviewId\n        && request.resource.data.id == reviewId\n        && request.resource.data.mangaId == mangaId\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.title is string\n        && request.resource.data.body is string\n        && request.resource.data.isDeleted == false\n        && hasInitialContentCounters();\n    }\n\n    match /users/{userId} {\n      allow read, write: if owner(userId);\n\n      match /favorites/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /readingHistory/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /preferences/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /devices/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /notifications/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /readerAnnotations/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /syncTombstones/{document=**} {\n        allow read, write: if owner(userId);\n      }\n\n      match /lists/{listId} {\n        allow read: if owner(userId) || (\n          get(/databases/$(database)/documents/publicProfiles/$(userId)).data.showListsPublic == true\n          && resource.data.isPublic == true\n        );\n        allow write: if owner(userId);\n\n        match /items/{document=**} {\n          allow read: if owner(userId) || (\n            get(/databases/$(database)/documents/publicProfiles/$(userId)).data.showListsPublic == true\n            && get(/databases/$(database)/documents/users/$(userId)/lists/$(listId)).data.isPublic == true\n          );\n          allow write: if owner(userId);\n        }\n      }\n    }\n\n    match /publicProfiles/{userId} {\n      allow read: if resource.data.isPublic == true || owner(userId);\n      allow create: if owner(userId)\n        && request.resource.data.keys().hasOnly(['username', 'displayName', 'avatarUrl', 'bannerUrl', 'isPublic', 'showListsPublic', 'showActivityPublic', 'showLibraryPublic', 'bio', 'badgeLabel', 'updatedAt']);\n      allow update: if owner(userId)\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'displayName', 'avatarUrl', 'bannerUrl', 'isPublic', 'showListsPublic', 'showActivityPublic', 'showLibraryPublic', 'bio', 'badgeLabel', 'updatedAt']);\n      allow delete: if owner(userId);\n    }\n\n    match /usernames/{username} {\n      allow read: if signedIn();\n      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;\n      allow update: if signedIn()\n        && resource.data.uid == request.auth.uid\n        && request.resource.data.uid == resource.data.uid;\n      allow delete: if signedIn() && resource.data.uid == request.auth.uid;\n    }\n\n    match /community_manga/{mangaId} {\n      allow read: if true;\n\n      match /comments/{commentId} {\n        allow read: if true;\n        allow create: if validCommentBase(mangaId, commentId)\n          && request.resource.data.chapterUrl == null\n          && validMangaCommentStructure(mangaId);\n        allow update: if authorOnlyCommentEdit();\n        allow delete: if false;\n\n        match /votes/{voterUid} {\n          allow read, write: if false;\n        }\n      }\n\n      match /reviews/{reviewId} {\n        allow read: if true;\n        allow create: if validReviewCreate(mangaId, reviewId);\n        allow update: if authorOnlyReviewEdit();\n        allow delete: if false;\n\n        match /votes/{voterUid} {\n          allow read, write: if false;\n        }\n      }\n\n      match /chapters/{chapterKey}/comments/{commentId} {\n        allow read: if true;\n        allow create: if validCommentBase(mangaId, commentId)\n          && request.resource.data.chapterUrl is string\n          && validChapterCommentStructure(mangaId, chapterKey);\n        allow update: if authorOnlyCommentEdit();\n        allow delete: if false;\n\n        match /votes/{voterUid} {\n          allow read, write: if false;\n        }\n      }\n    }\n\n    match /community_presence/{threadId} {\n      allow read: if true;\n\n      match /members/{memberId} {\n        allow read: if true;\n        allow write: if signedIn() && request.auth.uid == memberId;\n      }\n\n      match /reactions/{reactionId} {\n        allow read: if true;\n        allow create: if canWriteCommunity(request.resource.data.authorUid);\n        allow update: if canWriteCommunity(resource.data.authorUid)\n          && request.resource.data.authorUid == resource.data.authorUid;\n        allow delete: if canWriteCommunity(resource.data.authorUid);\n      }\n    }\n\n    match /moderationReports/{reportId} {\n      allow create: if canWriteCommunity(request.resource.data.reporterUid)\n        && request.resource.data.id == reportId\n        && request.resource.data.targetType in ['comment', 'review']\n        && request.resource.data.commentId is string\n        && (!request.resource.data.keys().hasAny(['targetId']) || (\n          request.resource.data.targetId is string\n          && request.resource.data.targetId == request.resource.data.commentId\n        ))\n        && request.resource.data.mangaId is string\n        && request.resource.data.reportedUid is string\n        && request.resource.data.reason is string\n        && request.resource.data.status == 'open';\n      allow read, update, delete: if canModerate();\n    }\n\n    match /user_achievements/{uid} {\n      allow read, write: if owner(uid);\n    }\n\n    match /email_registry/{email} {\n      allow read, write: if false;\n    }\n\n    match /relationships/{uid} {\n      allow read: if signedIn();\n      allow write: if false;\n\n      match /following/{targetUid} {\n        allow read: if signedIn();\n        allow create: if owner(uid) && request.resource.data.uid == targetUid;\n        allow update: if owner(uid) && request.resource.data.uid == resource.data.uid;\n        allow delete: if owner(uid);\n      }\n\n      match /followers/{followerUid} {\n        allow read: if signedIn();\n        allow create: if signedIn()\n          && followerUid == request.auth.uid\n          && request.resource.data.uid == request.auth.uid;\n        allow update: if signedIn()\n          && followerUid == request.auth.uid\n          && resource.data.uid == request.auth.uid\n          && request.resource.data.uid == resource.data.uid;\n        allow delete: if signedIn() && followerUid == request.auth.uid && resource.data.uid == request.auth.uid;\n      }\n    }\n\n    match /public/{document=**} {\n      allow read: if true;\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-24T05:19:04.657615Z","metadata":{"services":["cloud.firestore"]}}
