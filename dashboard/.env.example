NEXT_PUBLIC_FIREBASE_CLIENT_API_KEY=
# Firebase-hosted auth handler used by Google popup/redirect sign-in.
# Must stay exactly as configured in Firebase Console (Authentication →
# Settings → Authorized domains). If unset, it falls back to
# ${NEXT_PUBLIC_FIREBASE_PROJECT_ID}.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Public Google OAuth client ID (identifier only, not a secret) for the GIS
# button flow. Must match the Firebase-managed google.com provider client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
