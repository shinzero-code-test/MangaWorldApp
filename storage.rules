rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Cloudinary is the sole image-upload path (see AGENTS.md) — direct
      // Storage uploads are disabled, even for owners. The dashboard's
      // /api/cloudinary/* proxy plus Firestore ownership rows enforce this
      // server-side; this rule is the client-side backstop.
      allow write: if false;
    }
  }
}
