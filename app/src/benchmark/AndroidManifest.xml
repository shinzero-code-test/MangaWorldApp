<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay for the `benchmark` build type only (the app-under-test of the
  :benchmark macrobenchmark module).

  The app must be PROFILEABLE for MacrobenchmarkRule: it collects a
  Perfetto/atrace trace of the app process and measures frame timing.

  NOTE: `android:profileable` is NOT a public SDK attribute ("AAPT: error:
  attribute android:profileable not found"). The public form is the
  <profileable> ELEMENT inside <application>:

      <profileable android:shell="true" tools:targetApi="29" />

  (same shape as the official android/performance-samples
  MacrobenchmarkSample). `tools:targetApi` silences the API-29 lint on a
  minSdk-26 app.

  This file lives in its own build-type source set (app/src/benchmark), NOT in
  app/src/main: the shipping app is unaffected.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
