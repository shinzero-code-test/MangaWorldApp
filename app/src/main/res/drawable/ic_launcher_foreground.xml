<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108dp canvas, 72dp safe zone (18dp inset each side).
    Design: two manga volumes with a gold spine, centred in the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Circular backdrop inside the safe zone -->
    <path
        android:fillColor="#314A3B"
        android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0" />

    <!-- Left book body (cream pages) -->
    <path
        android:fillColor="#F8F4EC"
        android:pathData="M35,38h14c1.7,0 3,1.3 3,3v26c0,1.7 -1.3,3 -3,3H35c-1.7,0 -3,-1.3 -3,-3V41c0,-1.7 1.3,-3 3,-3z" />

    <!-- Left book page lines -->
    <path
        android:fillColor="#D4C8B4"
        android:strokeColor="#D4C8B4"
        android:strokeWidth="1"
        android:pathData="M38,44h8M38,48h8M38,52h6" />

    <!-- Right book body (slightly darker pages) -->
    <path
        android:fillColor="#E2D7C6"
        android:pathData="M57,38h14c1.7,0 3,1.3 3,3v26c0,1.7 -1.3,3 -3,3H57c-1.7,0 -3,-1.3 -3,-3V41c0,-1.7 1.3,-3 3,-3z" />

    <!-- Right book page lines -->
    <path
        android:fillColor="#C8BBa6"
        android:strokeColor="#C8BBA6"
        android:strokeWidth="1"
        android:pathData="M60,44h8M60,48h8M60,52h6" />

    <!-- Gold spine between the two books -->
    <path
        android:fillColor="#B58A54"
        android:pathData="M50,36h8c0.8,0 1.5,0.7 1.5,1.5v33c0,0.8 -0.7,1.5 -1.5,1.5h-8c-0.8,0 -1.5,-0.7 -1.5,-1.5v-33c0,-0.8 0.7,-1.5 1.5,-1.5z" />

    <!-- Spine highlight -->
