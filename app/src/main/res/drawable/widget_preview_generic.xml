<?xml version="1.0" encoding="utf-8"?>
<!-- v8: rich generic widget preview — mirrors the real widget chrome
     (accent-dot title row + rounded list rows + trailing badges) instead of
     the old empty rounded rectangle the launchers rendered. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#17141F"
                android:centerColor="#1D1B26"
                android:endColor="#251D33" />
        </shape>
    </item>
    <!-- Subtle top glow -->
    <item android:top="0dp" android:right="60dp" android:bottom="140dp" android:left="120dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:startColor="#267C4DFF"
                android:endColor="#007C4DFF" />
        </shape>
    </item>
    <!-- Title accent dot -->
    <item android:left="16dp" android:top="18dp" android:right="268dp" android:bottom="146dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#7C4DFF" />
        </shape>
    </item>
    <!-- Title bar -->
    <item android:left="26dp" android:top="16dp" android:right="150dp" android:bottom="140dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#E4E1ED" />
