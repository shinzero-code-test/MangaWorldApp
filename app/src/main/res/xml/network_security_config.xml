<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Allow the three manga sources -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">olympustaff.com</domain>
        <domain includeSubdomains="true">azoramoon.com</domain>
        <domain includeSubdomains="true">manga-starz.net</domain>
        <domain includeSubdomains="true">wsrv.nl</domain>
    </domain-config>
</network-security-config>
