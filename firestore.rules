rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canWriteCommunity(authorUid) {
      return signedIn() && request.auth.uid == authorUid;
    }

    match /users/{userId} {
      allow read, write: if owner(userId);

      match /favorites/{document=**} {
        allow read, write: if owner(userId);
      }

      match /readingHistory/{document=**} {
        allow read, write: if owner(userId);
      }

      match /preferences/{document=**} {
        allow read, write: if owner(userId);
      }

      match /devices/{document=**} {
        allow read, write: if owner(userId);
      }

      match /notifications/{document=**} {
        allow read, write: if owner(userId);
      }

      match /readerAnnotations/{document=**} {
        allow read, write: if owner(userId);
      }

      match /lists/{listId} {
        allow read, write: if owner(userId);

        match /items/{document=**} {
          allow read, write: if owner(userId);
        }
      }
    }

    match /publicProfiles/{userId} {
      allow read: if resource.data.isPublic == true || owner(userId);
      allow write: if owner(userId);
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /community_manga/{mangaId} {
      allow read: if true;

      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if canWriteCommunity(request.resource.data.authorUid);
        allow delete: if canWriteCommunity(resource.data.authorUid);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if canWriteCommunity(request.resource.data.authorUid);
        allow delete: if canWriteCommunity(resource.data.authorUid);
      }

      match /chapters/{chapterKey}/comments/{commentId} {
        allow read: if true;
        allow create, update: if canWriteCommunity(request.resource.data.authorUid);
        allow delete: if canWriteCommunity(resource.data.authorUid);
      }
    }

    match /community_presence/{threadId} {
      allow read: if true;

      match /members/{memberId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == memberId;
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create, update: if canWriteCommunity(request.resource.data.authorUid);
        allow delete: if canWriteCommunity(resource.data.authorUid);
      }
    }

    match /moderationReports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
